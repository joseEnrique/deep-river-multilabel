# Copia este fichero a `.env` (en este mismo directorio) antes de
# `docker compose up`. docker-compose lee `.env` automáticamente.
#
# El compose requiere API_KEY no vacía (todos los endpoints salvo
# /api/v1/health exigen X-API-Key o Authorization: Bearer <key>).
# El agent debe usar la misma clave (config.yaml: api_key) o
# exportar BACKEND_API_KEY=<key> en su entorno.

API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Estos sólo aplican si arrancas el binario directamente (sin docker):
BACKEND_ADDR=:8080
MONGO_URI=mongodb://localhost:27017
DB_PREFIX=experiments_
